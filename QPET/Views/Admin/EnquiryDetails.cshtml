@model QPET.Domain.Entities.Enquiry
@using QPET.Domain.Entities

@{
    ViewData["Title"] = "Enquiry Details";

    var notFound =
        ViewBag.EnquiryNotFound == true;

    var customer = Model.Customer;

    var branch = Model.Branch;


    var displayStatus =
        Model.Status == EnquiryStatus.InProgress
            ? "In Progress"
            : Model.Status.ToString();


    EnquiryStatus? nextStatus =
        Model.Status switch
        {
            EnquiryStatus.New =>
                EnquiryStatus.InProgress,

            EnquiryStatus.InProgress =>
                EnquiryStatus.Resolved,

            EnquiryStatus.Resolved =>
                EnquiryStatus.Closed,

            _ =>
                null
        };


    string? buttonText =
        Model.Status switch
        {
            EnquiryStatus.New =>
                "Start Processing",

            EnquiryStatus.InProgress =>
                "Mark as Resolved",

            EnquiryStatus.Resolved =>
                "Close Enquiry",

            _ =>
                null
        };


    var lifecycle =
        new[]
        {
            EnquiryStatus.New,
            EnquiryStatus.InProgress,
            EnquiryStatus.Resolved,
            EnquiryStatus.Closed
        };


    var statusFlow =
        string.Join(
            " → ",
            lifecycle.Select(
                status =>
                {
                    var formatted =
                        status == EnquiryStatus.InProgress
                            ? "In Progress"
                            : status.ToString();

                    return status == Model.Status
                        ? $"[{formatted}]"
                        : formatted;
                }
            )
        );
}


@if (notFound)
{
    <div class="admin-page-heading">

        <div>

            <h1>
                Enquiry Not Found
            </h1>

            <p>
                The requested enquiry could not be found.
            </p>

        </div>

    </div>


    <a asp-controller="Admin"
       asp-action="Enquiries"
       class="btn btn-primary">

        Return to Enquiries

    </a>
}
else
{
    <div id="adminEnquiryDetailsPage">

        <div class="admin-page-heading">

            <div>

                <span class="eyebrow">
                    Customer request
                </span>

                <h1>
                    Enquiry Details
                </h1>

                <p>
                    Review the submitted enquiry and
                    update its current status.
                </p>

            </div>


            <a asp-controller="Admin"
               asp-action="Enquiries"
               class="btn btn-secondary">

                ← Back to Enquiries

            </a>

        </div>


        <div class="admin-panel">


            <div class="admin-detail-section">

                <span class="section-kicker">
                    Reference
                </span>

                <h2>
                    ENQ-@Model.EnquiryId
                </h2>

            </div>


            <div class="admin-detail-section">

                <h2>
                    Customer
                </h2>


                <div class="admin-detail-list">

                    <div class="admin-detail-row">

                        <span>
                            Name
                        </span>

                        <strong>
                            @(customer?.FullName
                                                    ?? "Unknown")
                                                             </strong>

                    </div>


                    <div class="admin-detail-row">

                        <span>
                            Email
                        </span>

                        <strong>
                            @(customer?.EmailAddress
                                                    ?? "Not available")
                                                                   </strong>

                    </div>


                    <div class="admin-detail-row">

                        <span>
                            Phone
                        </span>

                        <strong>
                            @(customer?.PhoneNumber
                                                    ?? "Not available")
                                                                   </strong>

                    </div>

                </div>

            </div>


            <div class="admin-detail-section">

                <h2>
                    Enquiry
                </h2>


                <div class="admin-detail-list">

                    <div class="admin-detail-row">

                        <span>
                            Branch
                        </span>

                        <strong>
                            @(branch?.BranchName
                                                    ?? "Unknown")
                    </strong>

                    </div>


                    <div class="admin-detail-row">

                        <span>
                            Subject
                        </span>

                        <strong>
                            @Model.Subject
                        </strong>

                    </div>


                    <div class="admin-detail-row">

                        <span>
                            Date
                        </span>

                        <strong>
                            @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")
                        </strong>

                    </div>

                </div>


                <br />


                <span class="section-kicker">
                    Message
                </span>

                <p class="admin-enquiry-message">
                    @Model.Message
                </p>

            </div>


            <div class="admin-detail-section">

                <h2>
                    Attachments
                </h2>


                <div class="admin-attachment-list">

                @if (
                                Model.Attachments == null ||
                                Model.Attachments.Count == 0)
                    {
                        <p>
                            No attachments.
                        </p>
                    }
                    else
                    {
                        @foreach (var attachment in Model.Attachments)
                        {
                            <p>
                                <a asp-controller="Admin"
                                   asp-action="DownloadEnquiryAttachment"
                                   asp-route-enquiryId="@Model.EnquiryId"
                                   asp-route-attachmentId="@attachment.AttachmentId"
                                   class="admin-action-button">

                                    @attachment.OriginalFileName

                                </a>
                            </p>
                        }
                    }

                </div>

            </div>


            <div class="admin-detail-section">

                <h2>
                    Enquiry Status
                </h2>


                <p>
                    Current Status:

                    <strong>
                        @displayStatus
                    </strong>
                </p>


                <p>
                    @statusFlow
                </p>


                @if (
                            TempData["EnquiryMessage"]
                            is string statusMessage)
                {
                    <p class="admin-status-message">

                        @statusMessage

                    </p>
                }


                @if (nextStatus != null)
                {
                    <form asp-controller="Admin"
                          asp-action="UpdateEnquiryStatus"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.EnquiryId" />

                        <input type="hidden"
                               name="status"
                               value="@nextStatus" />


                        <button type="submit"
                                class="btn btn-primary">

                            @buttonText

                        </button>

                    </form>
                }
                else
                {
                    <p class="admin-status-message">

                        This enquiry has been closed.

                    </p>
                }

            </div>

        </div>

    </div>
}
